<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.0.3 Chrome/140.0.7339.249 Electron/38.7.0 Safari/537.36" version="29.0.3">
  <diagram name="Page-1" id="-8W5h6-VKMpftrF4il5p">
    <mxGraphModel dx="1895" dy="1138" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="OiilrH6_baQR4D4qtEZL-1" value="&lt;font style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;RAG - Retrieve Augmented Generation&lt;/b&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="430" height="50" as="geometry" />
        </mxCell>
        <mxCell id="OiilrH6_baQR4D4qtEZL-2" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="428.34" height="310" as="geometry" />
        </mxCell>
        <mxCell id="OiilrH6_baQR4D4qtEZL-4" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Conversational CRM Intelligence Agent&lt;/font&gt;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="430" height="50" as="geometry" />
        </mxCell>
        <mxCell id="OiilrH6_baQR4D4qtEZL-5" value="&lt;strong&gt;What problem does it solve?&lt;/strong&gt;&lt;br&gt;&#xa;Your users — sales reps, support staff, territory managers — currently have to navigate between modules manually. To answer &quot;which leads in Territory A haven&#39;t been visited this month but have open tickets?&quot; they&#39;d need to open Leads, Visits, Tickets, and cross-reference manually. This RAG makes that a single plain-language question." style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="450" width="720" height="110" as="geometry" />
        </mxCell>
        <mxCell id="OiilrH6_baQR4D4qtEZL-6" value="&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;Business requirements:&lt;/strong&gt;&lt;/p&gt;&lt;ul dir=&quot;ltr&quot;&gt;&lt;li&gt;A vector store per module (leads, tickets, sales, visits, expenses, territories) updated in near real-time as CRM records change&lt;/li&gt;&lt;br&gt;&lt;li&gt;A router agent that classifies which modules a query needs, and which tenant + usergroup context to apply before retrieval&lt;/li&gt;&lt;br&gt;&lt;li&gt;A critic/grounding agent that verifies the answer is supported by retrieved records — and retries if not&lt;/li&gt;&lt;br&gt;&lt;li&gt;Permission filtering baked into retrieval, not just the UI, so multi-tenant and usergroup isolation is enforced at the data layer&lt;/li&gt;&lt;/ul&gt;&lt;p dir=&quot;ltr&quot;&gt;&lt;strong&gt;How it affects user work:&lt;/strong&gt;&lt;br&gt;&lt;br&gt;Sales reps stop generating reports and start asking questions. Managers get cross-module answers in seconds. Support agents can ask &quot;what was this customer&#39;s visit history before their ticket opened?&quot; without switching screens.&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="730" height="230" as="geometry" />
        </mxCell>
        <mxCell id="OiilrH6_baQR4D4qtEZL-14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=3;" edge="1" parent="1" source="OiilrH6_baQR4D4qtEZL-7" target="OiilrH6_baQR4D4qtEZL-11">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="OiilrH6_baQR4D4qtEZL-7" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="790" width="740" height="90" as="geometry" />
        </mxCell>
